+int w_openRomPicker(lua_State *L)
+{
+	auto filesystem = Module::getInstance<filesystem::Filesystem>(Module::M_FILESYSTEM);
+	std::string requestId, message;
+	luax_catchexcept(L, [&]() {
+		love::android::openRomPicker(filesystem->getSaveDirectory().c_str(), requestId, message);
+	});
+	if (requestId.empty())
+	{
+		lua_pushnil(L);
+		luax_pushstring(L, message);
+	}
+	else
+	{
+		luax_pushstring(L, requestId);
+	}
+	return requestId.empty() ? 2 : 1;
+}
+
+int w_pollRomPicker(lua_State *L)
+{
+	love::android::RomPickerResult result;
+	bool available = false;
+	luax_catchexcept(L, [&]() { available = love::android::pollRomPicker(result); });
+	if (!available)
+	{
+		lua_pushnil(L);
+		return 1;
+	}
+	lua_newtable(L);
+	lua_pushstring(L, result.requestId.c_str());
+	lua_setfield(L, -2, "requestId");
+	lua_pushstring(L, result.kind.c_str());
+	lua_setfield(L, -2, "kind");
+	if (result.kind == "path")
+	{
+		lua_pushstring(L, result.relativePath.c_str());
+		lua_setfield(L, -2, "relativePath");
+		lua_pushstring(L, result.displayName.c_str());
+		lua_setfield(L, -2, "displayName");
+	}
+	else if (result.kind == "error")
+	{
+		lua_pushstring(L, result.message.c_str());
+		lua_setfield(L, -2, "message");
+	}
+	return 1;
+}
