+void checkJni(JNIEnv *env)
+{
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		throw std::runtime_error("Android ROM picker JNI call failed");
+	}
+}
+
+std::string fromJavaString(JNIEnv *env, jstring value)
+{
+	if (value == nullptr)
+		return {};
+	jclass stringClass = env->FindClass("java/lang/String");
+	checkJni(env);
+	jclass charsetClass = env->FindClass("java/nio/charset/StandardCharsets");
+	checkJni(env);
+	jmethodID utf8 = env->GetStaticMethodID(charsetClass, "UTF_8", "()Ljava/nio/charset/Charset;");
+	checkJni(env);
+	jobject charset = env->CallStaticObjectMethod(charsetClass, utf8);
+	checkJni(env);
+	jmethodID getBytes = env->GetMethodID(stringClass, "getBytes", "(Ljava/nio/charset/Charset;)[B");
+	checkJni(env);
+	jbyteArray bytes = (jbyteArray) env->CallObjectMethod(value, getBytes, charset);
+	checkJni(env);
+	std::string result;
+	if (bytes != nullptr)
+	{
+		jsize length = env->GetArrayLength(bytes);
+		result.resize(length);
+		if (length > 0)
+			env->GetByteArrayRegion(bytes, 0, length, (jbyte *) &result[0]);
+		checkJni(env);
+		env->DeleteLocalRef(bytes);
+	}
+	env->DeleteLocalRef(charset);
+	env->DeleteLocalRef(charsetClass);
+	env->DeleteLocalRef(stringClass);
+	env->DeleteLocalRef(value);
+	return result;
+}
+
+std::string arrayField(JNIEnv *env, jobjectArray array, jsize index)
+{
+	jstring value = (jstring) env->GetObjectArrayElement(array, index);
+	checkJni(env);
+	return fromJavaString(env, value);
+}
