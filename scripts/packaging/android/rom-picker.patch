+bool openRomPicker(const char *saveDirectory, std::string &requestId, std::string &message)
+{
+	JNIEnv *env = (JNIEnv *) SDL_AndroidGetJNIEnv();
+	jobject activity = currentActivity(env);
+	jclass clazz = env->GetObjectClass(activity);
+	checkJni(env);
+	jmethodID method = env->GetMethodID(clazz, "openRomPicker", "(Ljava/lang/String;)[Ljava/lang/String;");
+	checkJni(env);
+	jstring directory = env->NewStringUTF(saveDirectory);
+	checkJni(env);
+	jobjectArray values = (jobjectArray) env->CallObjectMethod(activity, method, directory);
+	checkJni(env);
+	jsize count = values == nullptr ? 0 : env->GetArrayLength(values);
+	if (count == 1)
+	{
+		requestId = arrayField(env, values, 0);
+		if (requestId.empty())
+			throw std::runtime_error("Android ROM picker returned an empty request token");
+	}
+	else if (count == 2)
+	{
+		requestId = arrayField(env, values, 0);
+		message = arrayField(env, values, 1);
+		if (!requestId.empty() || message.empty())
+			throw std::runtime_error("Android ROM picker returned a malformed open result");
+	}
+	else
+		throw std::runtime_error("Android ROM picker returned a malformed open result");
+
+	env->DeleteLocalRef(values);
+	env->DeleteLocalRef(directory);
+	env->DeleteLocalRef(clazz);
+	return !requestId.empty();
+}
+
+bool pollRomPicker(RomPickerResult &result)
+{
+	JNIEnv *env = (JNIEnv *) SDL_AndroidGetJNIEnv();
+	jobject activity = currentActivity(env);
+	jclass clazz = env->GetObjectClass(activity);
+	checkJni(env);
+	jmethodID method = env->GetMethodID(clazz, "pollRomPicker", "()[Ljava/lang/String;");
+	checkJni(env);
+	jobjectArray values = (jobjectArray) env->CallObjectMethod(activity, method);
+	checkJni(env);
+	if (values == nullptr)
+	{
+		env->DeleteLocalRef(clazz);
+		return false;
+	}
+	if (env->GetArrayLength(values) != 5)
+		throw std::runtime_error("Android ROM picker returned a malformed terminal result");
+	result.requestId = arrayField(env, values, 0);
+	result.kind = arrayField(env, values, 1);
+	result.relativePath = arrayField(env, values, 2);
+	result.displayName = arrayField(env, values, 3);
+	result.message = arrayField(env, values, 4);
+	bool valid = !result.requestId.empty();
+	if (result.kind == "path")
+		valid = valid && !result.relativePath.empty() && !result.displayName.empty() && result.message.empty();
+	else if (result.kind == "cancel")
+		valid = valid && result.relativePath.empty() && result.displayName.empty() && result.message.empty();
+	else if (result.kind == "error")
+		valid = valid && result.relativePath.empty() && result.displayName.empty() && !result.message.empty();
+	else
+		valid = false;
+	if (!valid)
+		throw std::runtime_error("Android ROM picker returned a malformed terminal result");
+
+	env->DeleteLocalRef(values);
+	env->DeleteLocalRef(clazz);
+	return true;
+}
