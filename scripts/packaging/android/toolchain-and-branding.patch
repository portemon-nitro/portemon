+    private void updateSafeAreaSnapshot(View decor, WindowInsets insets) {
+        if (insets == null || mSurface == null || mSurface.getWidth() <= 0 || mSurface.getHeight() <= 0) {
+            return;
+        }
+        int top = 0, left = 0, bottom = 0, right = 0;
+        int sdk = android.os.Build.VERSION.SDK_INT;
+        if (sdk >= 30) {
+            android.graphics.Insets safe = insets.getInsets(WindowInsets.Type.systemBars()
+                    | WindowInsets.Type.displayCutout() | WindowInsets.Type.systemGestures());
+            top = safe.top;
+            left = safe.left;
+            bottom = safe.bottom;
+            right = safe.right;
+        } else if (sdk >= 29) {
+            top = insets.getSystemWindowInsetTop();
+            left = insets.getSystemWindowInsetLeft();
+            bottom = insets.getSystemWindowInsetBottom();
+            right = insets.getSystemWindowInsetRight();
+            android.view.DisplayCutout cutout = insets.getDisplayCutout();
+            if (cutout != null) {
+                top = Math.max(top, cutout.getSafeInsetTop());
+                left = Math.max(left, cutout.getSafeInsetLeft());
+                bottom = Math.max(bottom, cutout.getSafeInsetBottom());
+                right = Math.max(right, cutout.getSafeInsetRight());
+            }
+            android.graphics.Insets gestures = insets.getSystemGestureInsets();
+            top = Math.max(top, gestures.top);
+            left = Math.max(left, gestures.left);
+            bottom = Math.max(bottom, gestures.bottom);
+            right = Math.max(right, gestures.right);
+        } else if (sdk >= 28) {
+            top = insets.getSystemWindowInsetTop();
+            left = insets.getSystemWindowInsetLeft();
+            bottom = insets.getSystemWindowInsetBottom();
+            right = insets.getSystemWindowInsetRight();
+            android.view.DisplayCutout cutout = insets.getDisplayCutout();
+            if (cutout != null) {
+                top = Math.max(top, cutout.getSafeInsetTop());
+                left = Math.max(left, cutout.getSafeInsetLeft());
+                bottom = Math.max(bottom, cutout.getSafeInsetBottom());
+                right = Math.max(right, cutout.getSafeInsetRight());
+            }
+        } else {
+            top = insets.getSystemWindowInsetTop();
+            left = insets.getSystemWindowInsetLeft();
+            bottom = insets.getSystemWindowInsetBottom();
+            right = insets.getSystemWindowInsetRight();
+        }
+
+        int[] decorLocation = new int[2];
+        int[] surfaceLocation = new int[2];
+        decor.getLocationInWindow(decorLocation);
+        mSurface.getLocationInWindow(surfaceLocation);
+        int windowLeft = decorLocation[0] + left;
+        int windowTop = decorLocation[1] + top;
+        int windowRight = decorLocation[0] + decor.getWidth() - right;
+        int windowBottom = decorLocation[1] + decor.getHeight() - bottom;
+        int surfaceLeft = surfaceLocation[0];
+        int surfaceTop = surfaceLocation[1];
+        int surfaceRight = surfaceLeft + mSurface.getWidth();
+        int surfaceBottom = surfaceTop + mSurface.getHeight();
+        int intersectionLeft = Math.max(windowLeft, surfaceLeft);
+        int intersectionTop = Math.max(windowTop, surfaceTop);
+        int intersectionRight = Math.min(windowRight, surfaceRight);
+        int intersectionBottom = Math.min(windowBottom, surfaceBottom);
+        if (intersectionRight <= intersectionLeft || intersectionBottom <= intersectionTop) {
+            return;
+        }
+        safeAreaSnapshot = new SafeAreaSnapshot(
+            Math.max(0, intersectionTop - surfaceTop),
+            Math.max(0, intersectionLeft - surfaceLeft),
+            Math.max(0, surfaceBottom - intersectionBottom),
+            Math.max(0, surfaceRight - intersectionRight)
+        );
+    }
