#!/usr/bin/env bash
# Installed by scripts/lib/repo-setup.sh via core.hooksPath. Bypass with --no-verify;
# CI runs the same fast lint gate, so a bypass only defers the failure.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# The lint gate owns both the worktree and the staged-index checks.
exec "$repo_root/scripts/lint.sh" --check
