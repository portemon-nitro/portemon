# Interactive development environment (direnv). Run `direnv allow` once to
# load it. This file is only ever evaluated by direnv: repo scripts own
# their own defaults in scripts/lib/dev.sh and must not depend on it.
#
# This local default keeps ROM-derived data out of $HOME during development.
# Preserve an explicitly inherited PORTEMON_SAVE_DIR so callers can isolate
# their save root.
export PORTEMON_SAVE_DIR="${PORTEMON_SAVE_DIR:-$PWD/.cache}"

# Contributor-installed tools (scripts/lib/repo-setup.sh) lead PATH so
# editors and plain shells resolve the same pinned builds the repo scripts
# use. PATH_add resolves the relative path against this file, and the
# entry is already in place before the first install lands.
PATH_add scripts/bin
