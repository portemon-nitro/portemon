# Local development environment (direnv). Run `direnv allow` once to load it;
# the scripts in scripts/ also source this file directly, so direnv is optional.
#
# This local default keeps ROM-derived data out of $HOME during development.
# Preserve an explicitly inherited PORTEMON_SAVE_DIR so callers can isolate
# their save root.
export PORTEMON_SAVE_DIR="${PORTEMON_SAVE_DIR:-$PWD/.cache}"
